# Local development environment
# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional defaults for soccer analysis
GEMINI_MODEL=gemini-2.5-pro
ANALYSIS_MODE=goalkeeper_review
OUTPUT_DIR=results
UPLOADS_DIR=uploads
ATHLETES_DIR=athletes
MAX_INLINE_BYTES=20000000
MAX_UPLOAD_BYTES=250000000
ANALYZE_RATE_LIMIT_WINDOW_MS=600000
ANALYZE_RATE_LIMIT_MAX_REQUESTS=20

# Optional cloud persistence mode (local Supabase stack)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL_ENABLED=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL=http://127.0.0.1:54321
