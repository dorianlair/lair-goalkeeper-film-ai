# Local development environment
# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional defaults for soccer analysis
GEMINI_MODEL=gemini-2.5-pro
ANALYSIS_MODE=goalkeeper_review
OUTPUT_DIR=results
UPLOADS_DIR=uploads
ATHLETES_DIR=athletes
MAX_INLINE_BYTES=20000000
MAX_UPLOAD_BYTES=250000000
ANALYZE_RATE_LIMIT_WINDOW_MS=600000
ANALYZE_RATE_LIMIT_MAX_REQUESTS=20

# Optional cloud persistence mode (enable both DATABASE_URL and S3_BUCKET)
DATABASE_URL=
DATABASE_SSL_ENABLED=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
