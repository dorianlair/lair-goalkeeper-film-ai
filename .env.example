# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Optional defaults for soccer analysis
ANALYSIS_MODE=goalkeeper_review
OUTPUT_DIR=results
UPLOADS_DIR=uploads
ATHLETES_DIR=athletes
MAX_INLINE_BYTES=20000000
MAX_UPLOAD_BYTES=250000000
ANALYZE_RATE_LIMIT_WINDOW_MS=600000
ANALYZE_RATE_LIMIT_MAX_REQUESTS=20

# Optional cloud persistence mode (local or hosted Supabase)
DATABASE_URL=
DATABASE_SSL_ENABLED=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
